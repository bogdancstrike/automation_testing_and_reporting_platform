# ── Application ──────────────────────────────────────────────────────────────
API_PORT=5100
DEV_MODE=true
LOG_LEVEL=INFO
SERVICE_NAME=qtp
ROLE=api
ALLOWED_ORIGINS=http://localhost:5173

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://qtp:qtp@localhost:5432/qtp
POSTGRES_USER=qtp
POSTGRES_PASSWORD=qtp
POSTGRES_DB=qtp
POSTGRES_PORT=5432

# ── Keycloak ─────────────────────────────────────────────────────────────────
# PUBLIC = browser-reachable (issuer). INTERNAL = compose-network (JWKS fetch).
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_REALM=qtp
KEYCLOAK_SPA_CLIENT_ID=qtp-spa
KEYCLOAK_AUDIENCE=qtp-api
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Set true to bypass auth entirely for local API smoke tests (never in prod).
AUTH_DISABLED=false

# ── Worker / scheduler ───────────────────────────────────────────────────────
WORKER_NAME=qtp-worker-1
WORKER_CAPABILITIES=http,python
WORKER_POLL_SECONDS=1.0

# ── Request-test SSRF / limits ───────────────────────────────────────────────
SSRF_BLOCK_PRIVATE=true
SSRF_ALLOWLIST=
REQUEST_MAX_BODY_BYTES=5242880

# ── Tracing ──────────────────────────────────────────────────────────────────
ENABLE_TRACING=false
OTLP_ENDPOINT=http://localhost:4317
