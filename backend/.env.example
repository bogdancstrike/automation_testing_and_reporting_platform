# ── Application ──────────────────────────────────────────────────────────────
API_PORT=5100
DEV_MODE=true
LOG_LEVEL=INFO
SERVICE_NAME=qtp
ROLE=api
ALLOWED_ORIGINS=http://localhost:5173

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://qtp:qtp@localhost:5432/qtp
POSTGRES_USER=qtp
POSTGRES_PASSWORD=qtp
POSTGRES_DB=qtp
POSTGRES_PORT=5432

# ── Keycloak ─────────────────────────────────────────────────────────────────
# PUBLIC = browser-reachable (issuer). INTERNAL = compose-network (JWKS fetch).
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_REALM=qtp
KEYCLOAK_SPA_CLIENT_ID=qtp-spa
KEYCLOAK_AUDIENCE=qtp-api
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Set true to bypass auth entirely for local API smoke tests (never in prod).
AUTH_DISABLED=false

# ── Worker / scheduler ───────────────────────────────────────────────────────
# WORKER_NAME is the shared Kafka *consumer group* for all worker replicas (the
# QF ETL uses it as group_id, so the broker splits partitions across replicas).
WORKER_NAME=qtp-workers
# Per-container identity for the workers table / dashboard (defaults to hostname).
# WORKER_INSTANCE_ID=
WORKER_CAPABILITIES=http,python
WORKER_MAX_CONCURRENCY=4
WORKER_POLL_SECONDS=1.0
WORKER_HEARTBEAT_SECONDS=5.0
WORKER_STALE_SECONDS=30.0
# Scheduler runs inside the backend as a greenlet; set false to disable on a node.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=2.0

# ── Kafka (worker transport) ─────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_RUNS_TOPIC=qtp-workers
KAFKA_RUNS_PARTITIONS=10
KAFKA_WORKER_EVENTS_TOPIC=qtp-worker-events
KAFKA_DLQ_TOPIC=qtp-workers-dlq
ERROR_TOPIC=qtp-errors

# ── Redis (required by the QF ETL kafka-worker runtime) ──────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Gunicorn (gevent workers) ────────────────────────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# ── Request-test SSRF / limits ───────────────────────────────────────────────
SSRF_BLOCK_PRIVATE=true
SSRF_ALLOWLIST=
REQUEST_MAX_BODY_BYTES=5242880

# ── Tracing ──────────────────────────────────────────────────────────────────
ENABLE_TRACING=false
OTLP_ENDPOINT=http://localhost:4317
