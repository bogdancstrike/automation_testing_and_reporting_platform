# QTP environment template — every knob read by src/config.py, plus infra vars
# used by docker-compose / gunicorn. Copy to .env and adjust. config.py only maps
# these to Python; the values live here. Commented lines show a derived/dynamic
# default; uncomment to override.

# ── Application ──────────────────────────────────────────────────────────────
SERVICE_NAME=qtp
API_PORT=5100
DEV_MODE=true
LOG_LEVEL=INFO
ROLE=api
ALLOWED_ORIGINS=http://localhost:5173

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://qtp:qtp@localhost:5432/qtp
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
# Used by the postgres container (compose), not config.py:
POSTGRES_USER=qtp
POSTGRES_PASSWORD=qtp
POSTGRES_DB=qtp
POSTGRES_PORT=5432

# ── Redis (only the QF ETL import chain reads it; QTP itself does not) ────────
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Keycloak ─────────────────────────────────────────────────────────────────
# PUBLIC = browser-reachable (issuer). INTERNAL = compose-network (JWKS fetch).
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://localhost:8080
KEYCLOAK_REALM=qtp
KEYCLOAK_SPA_CLIENT_ID=qtp-spa
KEYCLOAK_AUDIENCE=qtp-api
# Derived from PUBLIC_URL/INTERNAL_URL + REALM by default; override if needed:
# KEYCLOAK_ISSUER=http://localhost:8080/realms/qtp
# KEYCLOAK_JWKS_URL=http://localhost:8080/realms/qtp/protocol/openid-connect/certs
JWKS_CACHE_TTL=3600
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Set true to bypass auth entirely for local API smoke tests (never in prod).
AUTH_DISABLED=false

# ── Execution / worker ───────────────────────────────────────────────────────
# WORKER_NAME is the shared Kafka *consumer group* for all worker replicas (the
# QF ETL uses it as group_id, so the broker splits partitions across replicas).
WORKER_NAME=qtp-workers
# Per-container identity for the workers table / dashboard (defaults to hostname).
# WORKER_INSTANCE_ID=
WORKER_CAPABILITIES=http,python,cli,playwright,selenium
WORKER_MAX_CONCURRENCY=4
# Browser runs (playwright/selenium) execute in a separate OS process so the sync
# browser APIs don't collide with the worker's gevent hub.
BROWSER_RUN_TIMEOUT_S=180
BROWSER_MAX_CONCURRENCY=2
WORKER_POLL_SECONDS=1.0
WORKER_HEARTBEAT_SECONDS=5.0
WORKER_STALE_SECONDS=30.0
# Scheduler runs inside the backend as a greenlet; set false to disable on a node.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=2.0

# ── Kafka (worker transport) ─────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_RUNS_TOPIC=qtp-workers
KAFKA_RUNS_PARTITIONS=10
KAFKA_WORKER_EVENTS_TOPIC=qtp-worker-events
KAFKA_DLQ_TOPIC=qtp-workers-dlq
ERROR_TOPIC=qtp-errors

# ── Gunicorn (gevent workers) — read by gunicorn.conf.py, not config.py ───────
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# ── Request-test execution limits / SSRF ─────────────────────────────────────
REQUEST_MAX_TIMEOUT_MS=60000
REQUEST_MAX_BODY_BYTES=5242880
REQUEST_MAX_REDIRECTS=5
SSRF_BLOCK_PRIVATE=true
SSRF_ALLOWLIST=

# ── Tracing / secrets ────────────────────────────────────────────────────────
ENABLE_TRACING=false
OTLP_ENDPOINT=http://localhost:4317
# Fernet/key material for secret encryption — CHANGE THIS in any non-local use.
SECRET_ENCRYPTION_KEY=qtp-fallback-key-32bytes-long-123

# ── Test discovery ───────────────────────────────────────────────────────────
# Fallback module list; leave empty so the path scan discovers scenarios.
AUTOMATION_MODULES=
# QTP's own API base URL, used by the self-tests' 'qtp_self' target.
SELF_TARGET_URL=http://api:5100/qtp
